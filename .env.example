# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB

POSTGRES_USER=ft_user
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=ft_transcendence

# ─── Auth ─────────────────────────────────────────────────────────────────────
