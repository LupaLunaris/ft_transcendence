POSTGRES_USER=ft_user
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=ft_transcendence

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_EXPIRES_IN=7d

# ─── URLs ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# Vault secrets
# Left empty on purpose: written automatically by `vault/vault-init.sh`
# (called from `make docker-up`) on first run. Do not fill in by hand.
VAULT_ROLE_ID=
VAULT_SECRET_ID=
