generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  username           String   @unique
  password_hash      String
  avatar             String?
  diamonds           Int      @default(0)
  tower_progress     Int      @default(0)
  created_maps_count Int      @default(0)
  is_admin           Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  maps   Map[]
  scores Score[]
  
  friendships_sent      Friendship[] @relation("FriendshipRequester")
  friendships_received  Friendship[] @relation("FriendshipAddressee")
}

model Map {
  id                String   @id @default(uuid())
  name              String
  grid_json         String
  published         Boolean  @default(false)
  creator_completed Boolean  @default(false)
  difficulty        String   @default("EASY")
  play_count        Int      @default(0)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
  creator_id        String

  creator User    @relation(fields: [creator_id], references: [id], onDelete: Cascade)
  scores  Score[]
}

model AdminMap {
  id          String   @id @default(uuid())
  order_index Int      @unique
  name        String
  grid_json   String
  created_at  DateTime @default(now())
}

model Score {
  id                 String   @id @default(uuid())
  completion_time_ms Int
  created_at         DateTime @default(now())
  user_id            String
  map_id             String

  user User @relation(fields: [user_id], references: [id])
  map  Map  @relation(fields: [map_id], references: [id], onDelete: Cascade)

  @@index([map_id, completion_time_ms])
}

model Friendship {
  id            String    @id @default(uuid())
  created_at    DateTime  @default(now())
  
  requester_id  String
  addressee_id  String
  
  requester     User  @relation("FriendshipRequester", fields: [requester_id], references: [id], onDelete: Cascade)
  addressee     User  @relation("FriendshipAddressee", fields: [addressee_id], references: [id], onDelete: Cascade)

  @@unique([requester_id, addressee_id])
  @@index([requester_id])
  @@index([addressee_id])
}