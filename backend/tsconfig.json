{
	"compilerOptions": {
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"strict": true,
		"isolatedModules": true,
		"target": "ES2020",
		"module": "Node16",
		"moduleResolution": "node16",
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"types": ["jest", "node"]
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules", "dist"]
}
