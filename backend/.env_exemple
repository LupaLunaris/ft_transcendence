# Mode local (PostgreSQL local requis) — copier les valeurs depuis .env.example à la racine pour Docker
DATABASE_URL="postgresql://ft_user:dev_password@localhost:5432/guild_of_the_deep"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=dev_secret_change_me_in_production_use_at_least_64_random_chars
JWT_EXPIRES_IN=7d

# ─── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
